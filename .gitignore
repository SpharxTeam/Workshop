# =================================================================================
# .gitignore file for workshop project
# =================================================================================


# ========================
# Python cache
# ========================
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
*.pyc

# ========================
# 数据目录 (不提交任何数据文件，但保留目录结构)
# ========================
/partdata/
# 注意：partdata/ 下所有文件都不提交，包括依赖、模型、输入输出数据等

# 新 produce 目录：忽略所有实际数据，但允许 .gitkeep 文件存在以保留目录结构
produce/input/raw/*
produce/input/calibration/*
produce/output/processed/*
produce/output/datasets/*
!produce/input/raw/.gitkeep
!produce/input/calibration/.gitkeep
!produce/output/processed/.gitkeep
!produce/output/datasets/.gitkeep

# 旧路径兼容（如有，确保忽略）
/data/
/models/

# ========================
# 模型权重文件 
# ========================
*.pt
*.pth
*.bin
*.onnx
*.h5
*.pkl
*.joblib
*.safetensors

# ========================
# 本地环境文件 
# ========================
.env
.env.local
.venv/
venv/
env/
ENV/
pythonenv*
*.swp
*.swo

# ========================
# IDE 配置
# ========================
.vscode/
.idea/
*.sublime-*
.project
.classpath
.settings/
.lingma/

# ========================
# 系统文件
# ========================
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.dll
*.exe
*.msi
*.log

# ========================
# 日志文件
# ========================
*.log
/logs/
# common/logs/ 通常存放 .gitkeep，但运行时日志不应提交

# ========================
# Docker 构建缓存
# ========================
.dockerignore
docker-compose.override.yml
*.tar
*.tar.gz

# ========================
# Jupyter Notebook 临时文件
# ========================
.ipynb_checkpoints/
*.ipynb

# ========================
# 测试输出
# ========================
/test_output/
/temp/
/output/
*.result
*.out

# ========================
# 编辑器临时文件
# ========================
*~
\#*\#
.\#*

# ========================
# 操作系统生成的文件
# ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
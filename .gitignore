# .gitignore file for workshop project

# ========================
# Python cache
# ========================
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
*.pyc

# ========================
# 数据目录（保留目录结构，忽略所有文件）
# ========================
# partdata 下保留目录，但忽略所有实际文件（通过 .gitkeep 保留目录）
partdata/deps/*
!partdata/deps/.gitkeep
partdata/model/weights/*
!partdata/model/weights/.gitkeep
partdata/model/architecture/*
!partdata/model/architecture/.gitkeep

# produce 目录忽略所有实际数据
produce/input/raw/*
!produce/input/raw/.gitkeep
produce/input/calibration/*
!produce/input/calibration/.gitkeep
produce/output/processed/*
!produce/output/processed/.gitkeep
produce/output/datasets/*
!produce/output/datasets/.gitkeep

# ========================
# 模型权重文件（已通过 partdata/model/weights 覆盖，但保留通用规则）
# ========================
*.pt
*.pth
*.bin
*.onnx
*.h5
*.pkl
*.joblib
*.safetensors

# ========================
# 本地环境文件 
# ========================
.env
.env.local
.venv/
venv/
env/
ENV/
pythonenv*
*.swp
*.swo

# ========================
# IDE 配置
# ========================
.vscode/
.idea/
*.sublime-*
.project
.classpath
.settings/
.lingma/

# ========================
# 系统文件
# ========================
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.dll
*.exe
*.msi
*.log

# ========================
# 日志文件
# ========================
*.log
/logs/
# common/logs/ 通常存放 .gitkeep，但运行时日志不应提交

# ========================
# Docker 构建缓存
# ========================
.dockerignore
docker-compose.override.yml
*.tar
*.tar.gz

# ========================
# Jupyter Notebook 临时文件
# ========================
.ipynb_checkpoints/
*.ipynb

# ========================
# 测试输出
# ========================
/test_output/
/temp/
/output/
*.result
*.out

# ========================
# 编辑器临时文件
# ========================
*~
\#*\#
.\#*

# ========================
# 操作系统生成的文件
# ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
# ===== 项目身份 =====
PROJECT_PREFIX=spharx
ENVIRONMENT=development  # development, staging, production

# ===== 核心路径 (在服务器上对应挂载点) =====
# 数据完全外置，与代码分离
DATA_ROOT=/home/SpharxWorkshop/data
INPUT_SCENES_DIR=${DATA_ROOT}/input/scenes    # 放置 scene_001/, scene_002/
OUTPUT_DATASETS_DIR=${DATA_ROOT}/output/datasets
WORKSPACE_DIR=/home/SpharxWorkshop/workspace  # 临时处理空间

# ===== 产品开关 (灵活控制产出) =====
PRODUCE_2D_PRODUCT=true      # 是否生成2D标注数据集
PRODUCE_3D_GEOMETRY_PRODUCT=false  # 是否生成3D几何（依赖2D）
PRODUCE_3D_PHYSICS_PRODUCT=false   # 是否生成3D物理事实（依赖3D几何）

# ===== 阿里云OSS配置 (数据最终归宿) =====
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=spharx-datasets
OSS_PREFIX=${PROJECT_PREFIX}/
# !!! 以下密钥在部署时填写，切勿提交 !!!
OSS_ACCESS_KEY_ID=your_key_here
OSS_ACCESS_KEY_SECRET=your_secret_here

# ===== 服务配置 =====
CVAT_HOST=http://localhost:8080
CVAT_USERNAME=admin
CVAT_PASSWORD=changeme
# Docker网络，确保容器互通
DOCKER_NETWORK=${PROJECT_PREFIX}_network
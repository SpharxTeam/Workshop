# Workshop 环境变量配置模板
# 复制此文件为 .env 并根据实际情况修改配置

# ========== 基础配置 ==========
PYTHONPATH=/app/common/scripts
CONFIG_DIR=/app/common/configs
PARTDATA_ROOT=/partdata                         # 容器内数据根目录

# ========== 数据目录配置 ==========
RAW_DATA_DIR=${PARTDATA_ROOT}/raw               # 原始 bag 存放目录
WORKSHOP_OUTPUT_DIR=${PARTDATA_ROOT}/processed   # 中间处理结果
DATASETS_DIR=${PARTDATA_ROOT}/datasets           # 最终数据集
CALIBRATION_IMAGES_DIR=${PARTDATA_ROOT}/calibration_images

# ========== 日志配置 ==========
LOG_LEVEL=INFO
LOG_DIR=/logs
LOG_FILE=pipeline.log

# ========== 硬件配置 ==========
# RealSense 相机配置
REALSENSE_SERIAL_NUMBERS=
REALSENSE_FPS=30
REALSENSE_RESOLUTION_WIDTH=1280
REALSENSE_RESOLUTION_HEIGHT=720

# ========== 性能配置 ==========
MAX_WORKERS=4
MEMORY_LIMIT_GB=8
PARALLEL_PROCESSING=true
GPU_ENABLED=false

# ========== OSS 交付配置 ==========
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_REGION=cn-hangzhou

# ========== 通知配置 ==========
NOTIFICATION_EMAIL=
NOTIFICATION_WEBHOOK_URL=

# ========== 开发调试配置 ==========
DEBUG=false
DEV_MODE=false
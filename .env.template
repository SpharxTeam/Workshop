# ============================================================================
# Spharx Toolchain 环境变量配置模板
# 首次部署时复制为 .env 并修改以下字段
# 开发者邮箱: zhouzhixian@spharx.cn
# ============================================================================

# ------------------------------ 项目基础 --------------------------------
PROJECT_NAME=SpharxWorkshop
DEPLOY_ENV=development                # development / production
PROJECT_ROOT=${HOME}/SpharxWorkshop/toolchain
GIT_USER_EMAIL=zhouzhixian@spharx.cn
GIT_USER_NAME=Spharx Server

# ------------------------------ 核心路径 --------------------------------
# 开发阶段指向本地workspace，生产阶段指向OSS挂载点
DATA_ROOT=${HOME}/SpharxWorkshop/data
WORKSPACE_ROOT=${HOME}/SpharxWorkshop/workspace
LOG_ROOT=${WORKSPACE_ROOT}/logs

# ------------------------------ 2D标注服务 ------------------------------
CVAT_HOST=http://localhost:8080
CVAT_ADMIN_USER=admin
CVAT_ADMIN_PASS=Spharx2026
CVAT_DB_PASSWORD=cvat_spharx_2026

SAM_MODEL=vit_h                     # vit_h, vit_l, vit_b
SAM_DEVICE=cpu                      # cpu / cuda
SAM_API_URL=http://sam:8001/predict

# ------------------------------ 3D重建服务 ------------------------------
COLMAP_GPU_ENABLED=false
COLMAP_MAX_IMAGE_SIZE=2000
COLMAP_DENSE_QUALITY=normal         # low, normal, high

OPEN3D_MEMORY_LIMIT=8              # GB

# ------------------------------ 物理仿真 --------------------------------
BLENDER_RESOLUTION=512             # 渲染分辨率
PHYSICS_SIM_STEPS=240             # 仿真总帧数
PHYSICS_GRAVITY=-9.8

# ------------------------------ 阿里云OSS（生产环境必填）----------------
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=spharx-datasets
OSS_ACCESS_KEY_ID=your_access_key_here
OSS_ACCESS_KEY_SECRET=your_secret_key_here
OSS_PREFIX=production/datasets

# ------------------------------ 流水线开关 ------------------------------
PIPELINE_ENABLE_2D=true
PIPELINE_ENABLE_3D=false           # 待2D稳定后开启
PIPELINE_ENABLE_PHYSICS=false
PIPELINE_DRY_RUN=false            # 模拟运行，不实际调用工具
# ==================================================
# SPHARX TOOLCHAIN 环境变量模板
# 复制为 .env 并填写实际值
# ==================================================

# ========== 基础配置 ==========
PROJECT_NAME=spharx-toolchain
VERSION=v1.0.0
DEBUG=false

# ========== 路径配置 ==========
# 本地工作目录（建议挂载OSS）
DATA_ROOT=/data/spharx
WORKSPACE_ROOT=/workspace
OUTPUT_ROOT=/output

# ========== 服务端口配置 ==========
CVAT_PORT=8080
CVAT_DB_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ========== 认证密钥 ==========
# CVAT管理员账户
CVAT_ADMIN_USERNAME=admin
CVAT_ADMIN_PASSWORD=ChangeMe123!
CVAT_ADMIN_EMAIL=admin@spharx.com

# MinIO/OSS凭证
OSS_ACCESS_KEY_ID=your_access_key
OSS_SECRET_ACCESS_KEY=your_secret_key
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=spharx-datasets

# ========== Docker配置 ==========
# GPU支持（cuda11.8/cuda12.1/cpu）
CUDA_VERSION=cuda11.8
GPU_ENABLED=true

# 镜像仓库
DOCKER_REGISTRY=registry.cn-beijing.aliyuncs.com/spharx
IMAGE_TAG=latest

# ========== 流水线控制开关 ==========
# 是否启用各阶段（true/false）
STAGE_2D_ANNOTATION=true
STAGE_3D_RECONSTRUCTION=true
STAGE_PHYSICS_GENERATION=true

# 并行处理配置
MAX_CONCURRENT_TASKS=4
MEMORY_LIMIT_GB=32

# ========== 第三方服务 ==========
# Segment Anything API（可选）
SAM_API_URL=http://sam-service:8000
SAM_MODEL_TYPE=vit_h

# COLMAP配置
COLMAP_GPU_INDEX=0
COLMAP_MAX_IMAGE_SIZE=1920

# ========== 日志与监控 ==========
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/spharx
ENABLE_MONITORING=true
PROMETHEUS_PORT=9090

# ========== 开发配置 ==========
DEVELOPMENT_MODE=false
TEST_DATA_PATH=/tests/fixtures/sample_scene_01
SKIP_VALIDATION=false
# ============================================
# SpharxWorkshop 环境配置文件模板
# ============================================
# 重要：将此文件复制为 .env 并填写实际值
#       此文件仅作为模板，不包含真实密钥
# ============================================

# ===== 项目基本配置 =====
# 项目名称，用于容器命名和日志标识
PROJECT_NAME=SpharxWorkshop

# 运行环境：DEVELOPMENT(开发) / STAGING(测试) / PRODUCTION(生产)
PROJECT_STAGE=DEVELOPMENT

# ===== 目录路径配置 =====
# 服务器上工作空间的根目录（部署脚本会自动创建）
SPHARX_WORKSHOP_ROOT=/home/SpharxWorkshop

# 数据根目录（输入和输出都挂载于此）
SPHARX_DATA_ROOT=${SPHARx_WORKSHOP_ROOT}/data

# 原始数据输入目录（用户放置拍摄的场景数据）
# 结构：input/scenes/scene_001/images/...
SPHARX_INPUT_DIR=${SPHARX_DATA_ROOT}/input/scenes

# 处理后的数据集输出目录
# 结构：output/datasets/SPHARX_PHYSICS_001/L1_2d_annotations/...
SPHARX_OUTPUT_DIR=${SPHARX_DATA_ROOT}/output/datasets

# 临时工作区（处理过程中的中间文件）
SPHARX_WORKSPACE_DIR=${SPHARX_WORKSHOP_ROOT}/workspace

# ===== Docker服务网络配置 =====
# Docker Compose 使用的网络名称（保持默认即可）
DOCKER_NETWORK_NAME=spharx-network

# ===== 2D标注服务配置 =====
# CVAT 标注平台配置（如启用2D流水线需要）
# CVAT访问地址（通常为localhost或服务器IP）
CVAT_HOST=http://localhost:8080
CVAT_USERNAME=admin
CVAT_PASSWORD=changeme123  # 首次启动后务必修改！

# SAM 模型配置（用于自动预标注）
# 可选模型: vit_h（最大/最准）、vit_l、vit_b（最小/最快）
SAM_MODEL=vit_h
SAM_CHECKPOINT_PATH=/models/sam_vit_h_4b8939.pth

# ===== 3D重建服务配置 =====
# COLMAP 配置
COLMAP_MAX_IMAGE_SIZE=1600  # 图像最大尺寸（像素），越大越精确但越慢
COLMAP_MAX_FEATURES=8192    # 每张图像提取的最大特征点数

# Open3D 配置
O3D_VISUALIZE=false         # 是否开启可视化（生产环境设为false）
O3D_VOXEL_SIZE=0.01         # 下采样体素大小（米）

# ===== 物理仿真配置 =====
# Blender 配置
BLENDER_PATH=/usr/local/blender/blender
BLENDER_PYTHON_PATH=/usr/local/blender/3.3/python/bin/python3.10

# 物理仿真参数
PHYSICS_SIMULATION_STEPS=250    # 仿真步数
PHYSICS_GRAVITY=-9.81          # 重力加速度 (m/s^2)

# ===== 阿里云 OSS 配置（必须修改！） =====
# 重要：以下配置需要从阿里云控制台获取
# 访问 https://oss.console.aliyun.com 创建Bucket

# OSS Endpoint（地域节点）
# 示例：杭州区域为 oss-cn-hangzhou.aliyuncs.com
# 请根据你的Bucket所在地域填写
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# Bucket 名称（在OSS中创建的存储空间名称）
OSS_BUCKET=your-bucket-name

# 访问密钥（从阿里云RAM控制台获取）
OSS_ACCESS_KEY_ID=your_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_access_key_secret_here

# OSS 路径配置
OSS_INPUT_PREFIX=spharx/raw_data/      # 原始数据上传路径前缀
OSS_OUTPUT_PREFIX=spharx/datasets/     # 成品数据集路径前缀
OSS_BACKUP_PREFIX=spharx/backups/      # 备份路径前缀

# ===== 流水线控制开关 =====
# 是否启用2D标注流水线（图像->2D标注）
ENABLE_2D_PIPELINE=true

# 是否启用3D重建流水线（多视图->3D模型）
ENABLE_3D_PIPELINE=false   # 初期可先关闭，专注2D流程

# 是否启用物理事实生成流水线
ENABLE_PHYSICS_PIPELINE=false

# ===== 任务队列与并发配置 =====
# 最大并发任务数（根据服务器CPU核心数调整）
MAX_CONCURRENT_TASKS=4

# 单个任务超时时间（秒）
TASK_TIMEOUT_SECONDS=7200  # 2小时

# ===== 日志与监控配置 =====
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 是否启用详细日志（生产环境建议关闭）
VERBOSE_LOGGING=true

# Prometheus监控端口（如启用监控）
METRICS_PORT=9090

# ===== 安全配置 =====
# API密钥（用于外部调用流水线）
API_SECRET_KEY=generate_a_secure_random_string_here

# 是否启用HTTPS（生产环境必须）
ENABLE_HTTPS=false

# ===== 开发调试配置 =====
# 是否跳过耗时步骤（仅用于测试）
SKIP_HEAVY_COMPUTATIONS=false

# 测试模式：使用小样本快速验证流程
TEST_MODE=false
TEST_SAMPLE_COUNT=10

# ===== 备份与保留策略 =====
# 保留原始数据天数（0表示永久）
RETAIN_RAW_DATA_DAYS=30

# 保留中间文件天数
RETAIN_INTERMEDIATE_DAYS=7

# 自动备份成品数据集（true/false）
AUTO_BACKUP_DATASETS=true

# ============================================
# 配置完成提示
# ============================================
# 1. 将此文件复制为 .env
#    cp .env.template .env
# 2. 编辑 .env 文件，填写真实的OSS密钥等信息
# 3. 确保 .env 在 .gitignore 中，不要提交到版本控制！
# ============================================